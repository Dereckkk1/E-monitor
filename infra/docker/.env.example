# Postgres
POSTGRES_DB=radiocheck
POSTGRES_USER=radiocheck
POSTGRES_PASSWORD=radiocheck

# MinIO (S3-compatible local)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=radiocheck-evidence
# Endpoint baked into presigned evidence URLs (must be reachable from the
# user's browser, not from the API container). Override in production with
# the public bucket / R2 hostname. Defaults to http://localhost:9000.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Service ports (host-mapped)
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Teto soft do HEAP GO no container api. NÃO cobre o RSS dos ~200 ffmpeg de
# captura (que rodam no mesmo container mas fora do heap Go — termo dominante
# de RAM, ~88MB base + 14.8MB/emissora ≈ 3GB a 200 emissoras). Por isso o
# service api não tem mem_limit no compose (ver bloco abaixo).
# "off" = sem limite (default). Em prod: 6GiB.
API_GOMEMLIMIT=off

# Teto do pool de conexoes pgx (API + jobs + reqmetrics compartilham).
# Default 20; prod: 40 (setar no .env da VM; max_connections do PG e 100).
DB_MAX_CONNS=20

# Tuning do Postgres (command: no compose) — defaults = valores de fábrica
# do PG 16, no-op em dev. Prod (VM c3-highcpu-8, 16GB RAM, SSD dedicado
# /mnt/db; conta completa em docs/operations/deploy.md):
#   PG_SHARED_BUFFERS=2GB  PG_EFFECTIVE_CACHE_SIZE=5GB  PG_WORK_MEM=16MB
#   PG_MAINTENANCE_WORK_MEM=512MB  PG_AUTOVACUUM_WORK_MEM=128MB
#   PG_MAX_WAL_SIZE=4GB
# PG_AUTOVACUUM_WORK_MEM é crítico: sem ele, os 3 workers de autovacuum
# herdam PG_MAINTENANCE_WORK_MEM inteiro (default -1) — 3×512MB=1.5GB —
# e isso estoura o PG_MEM_LIMIT junto com shared_buffers+work_mem.
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_AUTOVACUUM_WORK_MEM=-1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAX_WAL_SIZE=1GB

# Reservas/limites de memória (mem_reservation/mem_limit no compose).
# 0 = sem limite (default, dev). Prod (VM c3-highcpu-8, 16GB RAM):
# PG_MEM_RESERVATION=3g PG_MEM_LIMIT=6g MINIO_MEM_LIMIT=1g.
# O service api NÃO tem mem_limit de propósito — roda os ~200 ffmpeg de
# captura; um hard limit ali poderia OOM-killar a captura. Proteção do
# api é soft, via API_GOMEMLIMIT acima.
PG_MEM_RESERVATION=256m
PG_MEM_LIMIT=0
MINIO_MEM_LIMIT=0

# Production data paths (bind mounts) — DEIXE EM BRANCO EM DEV.
# Em prod aponte cada um para um path absoluto do host (disco grande/durável).
# Sem isso, cada volume cai no named volume default (em /var/lib/docker, no
# disco de OS). Ver CLAUDE.md §4.4 e docs/operations/data-durability.md.
# PGDATA_HOST_PATH=/mnt/db/pgdata
# MINIODATA_HOST_PATH=/mnt/data/minio
# MASTERSDATA_HOST_PATH=/mnt/data/masters
# SEGMENTSDATA_HOST_PATH=/mnt/data/segments   # segmentos de evidência efêmeros (~5GB+); ver docs/operations/segments-disk-migration.md
