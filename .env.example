# Radiocheck — example environment file.
#
# Copy to `.env` and adjust before running `docker compose up`.
# Production deployments must replace every secret value below.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=radiocheck
POSTGRES_USER=radiocheck
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── NATS ──────────────────────────────────────────────────────────────────
NATS_PORT=4222

# ── MinIO / S3 ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=radiocheck
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=radiocheck-evidences

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=8080

# ── Stream simulator (optional, profile=sim) ──────────────────────────────
SIM_PORT=18000
SIM_QUALITY=fm-standard
SIM_GAP_SECONDS=15

# ── OpenTelemetry tracing (§15.3) ─────────────────────────────────────────
# Setting OTEL_EXPORTER_OTLP_ENDPOINT enables OTLP gRPC export. Leave empty
# to install the no-op TracerProvider (no spans, no panics, no startup
# delay).
#
# Defaults below match the Jaeger all-in-one container shipped in
# infra/docker/docker-compose.yml (UI at http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_SERVICE_NAME=radiocheck-api
# Sampling: parent-based ratio. In dev keep 1.0 to see everything; in prod
# drop to 0.1 so the high-cardinality "worker.window" spans don't flood
# Jaeger.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Optional resource attributes baked into every span.
OTEL_RESOURCE_ATTRIBUTES=
# Production / staging / development. Becomes the `deployment.environment`
# resource attribute.
RADIOCHECK_ENV=development

# ── Calibration scheduler (§9.4, optional overrides) ──────────────────────
# CALIBRATION_INTERVAL=24h
# CALIBRATION_MIN_AGE=168h
